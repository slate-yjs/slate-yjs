{
  "name": "@slate-yjs/react",
  "sideEffects": false,
  "version": "1.1.1",
  "description": "React specific components/utils for slate-yjs.",
  "keywords": [
    "slate",
    "yjs",
    "collaborative",
    "react"
  ],
  "type": "module",
  "exports": {
    "require": "./dist/index.cjs",
    "default": "./dist/index.js"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "unpkg": "dist/index.global.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slate-yjs/slate-yjs.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@slate-yjs/core": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "slate": "^0.147.4",
    "slate-dom": "^0.147.3",
    "slate-react": "^0.147.6",
    "tsup": "^5.12.1",
    "typescript": "^4.6.3",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "@slate-yjs/core": "^1.0.0",
    "react": ">=16.8.0",
    "slate": ">=0.70.0",
    "slate-react": ">=0.70.0",
    "yjs": "^13.5.29"
  },
  "bugs": {
    "url": "https://github.com/slate-yjs/slate-yjs/issues"
  },
  "homepage": "https://github.com/slate-yjs/slate-yjs#readme",
  "dependencies": {
    "use-sync-external-store": "^1.7.0"
  }
}
